<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1. Changed to standard Material3 (Tonal Spot) instead of Expressive -->
    <style name="Theme.NoteApp" parent="Theme.Material3.DayNight.NoActionBar">
        
        <!-- 2. Fallback colors (used if Dynamic Colors are disabled/unavailable) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Note: colorPrimaryVariant and circular ?attr/ references were removed -->

        <!-- 3. To support your edge-to-edge UI in Kotlin, it's best to set these to transparent -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
    </style>
</resources>
