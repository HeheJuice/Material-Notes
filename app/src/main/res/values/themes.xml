<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme, inherits from MaterialComponents for dynamic color -->
    <style name="Theme.NoteApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (will be overridden by Monet on Android 12+) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- Enable dynamic color on Android 12+ -->
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="android:colorPrimaryVariant">?attr/colorPrimaryVariant</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <!-- Status bar / navigation bar colours (optional) -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>
</resources>